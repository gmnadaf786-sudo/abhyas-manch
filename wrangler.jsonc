{
  "name": "abhyas-manch",
  "main": "worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "BOOKS", "bucket_name": "books" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "am-users-in", "database_id": "32eb0036-1575-4df7-9901-bb6a4ebdd961" }
  ]
}
