{"SCH4":{"प्रथम भाषा (मराठी)":{"शब्दसंपत्तीवरील प्रभुत्व":{"समानार्थी शब्द":{"learn":[{"h":"समानार्थी शब्द म्हणजे काय?","t":"ज्या शब्दांचा अर्थ सारखा असतो, पण शब्द वेगवेगळे असतात, त्यांना समानार्थी शब्द म्हणतात.\n\nसमान = सारखा, अर्थ = मतलब.\n\nउदा.\nआई = माता = जननी\nपाणी = जल = नीर = उदक\n\nएकाच गोष्टीला अनेक नावे असतात, तसेच हे आहे!"},{"h":"निसर्गातील शब्द","t":"सूर्य = रवी, भास्कर, दिनकर\nचंद्र = शशी, सोम, चांदोबा\nआकाश = गगन, नभ, अंबर\nपाणी = जल, नीर, उदक\nवारा = वायू, पवन, अनिल\nढग = मेघ, जलद, अभ्र\nपाऊस = वर्षा, पर्जन्य\nडोंगर = पर्वत, गिरी, अचल\nनदी = सरिता, तटिनी\nसमुद्र = सागर, सिंधू, जलधी\nपृथ्वी = धरणी, भूमी, वसुंधरा\nरात्र = निशा, रजनी"},{"h":"झाडे, फुले व प्राणी","t":"झाड = वृक्ष, तरू\nफूल = पुष्प, सुमन, कुसुम\nकमळ = पंकज, अंबुज, पद्म\nहत्ती = गज, कुंजर\nघोडा = अश्व, तुरंग, वारू\nमोर = मयूर\nकावळा = काक\nगाय = धेनू\nसिंह = केसरी, वनराज\nवाघ = व्याघ्र"},{"h":"माणसे, अवयव व घर","t":"आई = माता, जननी\nवडील = पिता, तात\nमुलगा = पुत्र, सुत\nमुलगी = कन्या, सुता\nमित्र = सखा, सोबती, स्नेही\nशत्रू = वैरी, रिपू\nराजा = नृप, नरेश, भूपती\nडोळा = नयन, लोचन, नेत्र\nहात = कर, हस्त\nपाय = चरण, पद\nघर = गृह, सदन, निवास\nआनंद = हर्ष, मोद"},{"h":"लक्षात ठेवा","t":"1) प्रश्नातील शब्द वाचा आणि त्याचा अर्थ मनात आणा.\n2) पर्यायांतील जो शब्द त्याच अर्थाचा असेल तो निवडा.\n3) विरुद्ध अर्थाचा शब्द (उदा. सुख × दुःख) हा समानार्थी नसतो!\n4) वाक्यात शब्द बदलून पाहा. वाक्याचा अर्थ तोच राहिला तर शब्द समानार्थी आहे.\n\nचला, आता सराव करूया! 💪"}],"q":[{"i":"L4M_SA01","c":"समानार्थी शब्द","q":"'आई' या शब्दाचा समानार्थी शब्द कोणता?","o":["माता","पिता","बंधू","ताई"],"a":0,"e":"आई = माता = जननी"},{"i":"L4M_SA02","c":"समानार्थी शब्द","q":"'सूर्य' या शब्दाचा समानार्थी शब्द कोणता?","o":["चंद्र","रवी","तारा","ढग"],"a":1,"e":"सूर्य = रवी = भास्कर = दिनकर"},{"i":"L4M_SA03","c":"समानार्थी शब्द","q":"'पाणी' या शब्दाचा समानार्थी शब्द कोणता?","o":["जल","अग्नी","वारा","माती"],"a":0,"e":"पाणी = जल = नीर = उदक"},{"i":"L4M_SA04","c":"समानार्थी शब्द","q":"'आकाश' या शब्दाचा समानार्थी शब्द कोणता?","o":["धरणी","सागर","गगन","पर्वत"],"a":2,"e":"आकाश = गगन = नभ = अंबर"},{"i":"L4M_SA05","c":"समानार्थी शब्द","q":"'फूल' या शब्दाचा समानार्थी शब्द कोणता?","o":["वृक्ष","पुष्प","फळ","पान"],"a":1,"e":"फूल = पुष्प = सुमन = कुसुम"},{"i":"L4M_SA06","c":"समानार्थी शब्द","q":"'झाड' या शब्दाचा समानार्थी शब्द कोणता?","o":["तरू","सरिता","किरण","गज"],"a":0,"e":"झाड = वृक्ष = तरू"},{"i":"L4M_SA07","c":"समानार्थी शब्द","q":"'नदी' या शब्दाचा समानार्थी शब्द कोणता?","o":["सागर","सरिता","गिरी","गृह"],"a":1,"e":"नदी = सरिता = तटिनी"},{"i":"L4M_SA08","c":"समानार्थी शब्द","q":"'डोंगर' या शब्दाचा समानार्थी शब्द कोणता?","o":["पर्वत","समुद्र","अरण्य","मेघ"],"a":0,"e":"डोंगर = पर्वत = गिरी = अचल"},{"i":"L4M_SA09","c":"समानार्थी शब्द","q":"'समुद्र' या शब्दाचा समानार्थी शब्द कोणता?","o":["सरिता","सागर","वृक्ष","नयन"],"a":1,"e":"समुद्र = सागर = सिंधू = जलधी"},{"i":"L4M_SA10","c":"समानार्थी शब्द","q":"'हत्ती' या शब्दाचा समानार्थी शब्द कोणता?","o":["अश्व","गज","मयूर","केसरी"],"a":1,"e":"हत्ती = गज = कुंजर"},{"i":"L4M_SA11","c":"समानार्थी शब्द","q":"'घोडा' या शब्दाचा समानार्थी शब्द कोणता?","o":["तुरंग","पवन","वारू","दोन्ही: तुरंग व वारू"],"a":3,"e":"घोडा = अश्व = तुरंग = वारू"},{"i":"L4M_SA12","c":"समानार्थी शब्द","q":"'रात्र' या शब्दाचा समानार्थी शब्द कोणता?","o":["दिन","निशा","उषा","सकाळ"],"a":1,"e":"रात्र = निशा = रजनी"},{"i":"L4M_SA13","c":"समानार्थी शब्द","q":"'डोळा' या शब्दाचा समानार्थी शब्द कोणता?","o":["कर","चरण","नयन","कर्ण"],"a":2,"e":"डोळा = नयन = लोचन = नेत्र"},{"i":"L4M_SA14","c":"समानार्थी शब्द","q":"'घर' या शब्दाचा समानार्थी शब्द कोणता?","o":["गृह","वन","शाळा","मंदिर"],"a":0,"e":"घर = गृह = सदन = निवास"},{"i":"L4M_SA15","c":"समानार्थी शब्द","q":"'वारा' या शब्दाचा समानार्थी शब्द कोणता?","o":["पवन","जल","अग्नी","भूमी"],"a":0,"e":"वारा = वायू = पवन = अनिल"},{"i":"L4M_SA16","c":"समानार्थी शब्द","q":"'ढग' या शब्दाचा समानार्थी शब्द कोणता?","o":["वर्षा","मेघ","तारा","किरण"],"a":1,"e":"ढग = मेघ = जलद = अभ्र"},{"i":"L4M_SA17","c":"समानार्थी शब्द","q":"'मित्र' या शब्दाचा समानार्थी शब्द कोणता?","o":["वैरी","सखा","रिपू","दुश्मन"],"a":1,"e":"मित्र = सखा = सोबती = स्नेही. वैरी, रिपू, दुश्मन म्हणजे शत्रू."},{"i":"L4M_SA18","c":"समानार्थी शब्द","q":"खालीलपैकी कोणत्या शब्दांची जोडी समानार्थी आहे?","o":["सूर्य – चंद्र","वारा – पवन","दिवस – रात्र","आई – वडील"],"a":1,"e":"वारा आणि पवन यांचा अर्थ सारखा आहे."},{"i":"L4M_SA19","c":"समानार्थी शब्द","q":"खालीलपैकी कोणत्या शब्दांची जोडी समानार्थी आहे?","o":["गगन – नभ","सुख – दुःख","उंच – ठेंगणा","काळा – पांढरा"],"a":0,"e":"गगन आणि नभ हे दोन्ही आकाशाचे समानार्थी शब्द आहेत."},{"i":"L4M_SA20","c":"समानार्थी शब्द","q":"'पृथ्वी' या शब्दाचा समानार्थी शब्द ओळखा.","o":["धरणी","वेल","किरण","सागर"],"a":0,"e":"पृथ्वी = धरणी = भूमी = वसुंधरा"},{"i":"L4M_SA21","c":"समानार्थी शब्द","q":"'राजा' या शब्दाचा समानार्थी शब्द कोणता?","o":["नरेश","शिष्य","सैनिक","दास"],"a":0,"e":"राजा = नरेश = नृप = भूपती"},{"i":"L4M_SA22","c":"समानार्थी शब्द","q":"'कमळ' या शब्दाचा समानार्थी शब्द कोणता?","o":["मोर","पंकज","मेघ","झरा"],"a":1,"e":"कमळ = पंकज = अंबुज = पद्म"},{"i":"L4M_SA23","c":"समानार्थी शब्द","q":"'पाऊस' या शब्दाचा समानार्थी शब्द कोणता?","o":["वर्षा","ऊन","धुके","वारा"],"a":0,"e":"पाऊस = वर्षा = पर्जन्य"},{"i":"L4M_SA24","c":"समानार्थी शब्द","q":"'आनंद' या शब्दाचा समानार्थी शब्द कोणता?","o":["खेद","हर्ष","राग","भीती"],"a":1,"e":"आनंद = हर्ष = मोद = सुख"},{"i":"L4M_SA25","c":"समानार्थी शब्द","q":"वाक्यात अधोरेखित शब्दाचा समानार्थी शब्द वापरा: 'आकाशात ढग जमले.' (आकाशात = ?)","o":["गगनात","भूमीत","जलात","वनात"],"a":0,"e":"आकाश = गगन, म्हणून 'गगनात ढग जमले' असे म्हणता येते."}]}}}}}